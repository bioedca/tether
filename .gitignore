# --- Local-only working docs (never committed; see CLAUDE.md / PLAN.md) ---
CLAUDE.md
PLAN.md
# Claude Code working directory. Named paths rather than a blanket `.claude/`: a directory-wide
# ignore silently swallows anything an agent leaves there, including files that should have been
# reviewed. Everything currently on disk stays ignored — `scheduled_tasks.lock` via `*.lock` below.
.claude/worktrees/
.claude/settings.local.json
.claude/*.py
.claude/RESUME-SWARM-REBUILD.md
# gate.ps1's PID-liveness admission slots (.pid files, so *.lock below does not cover them)
.claude/gate-slots/

# swarm_slots.py renders one task file per launched worker into a TRACKED directory. The templates
# (build.md, amend.md) are committed; the rendered per-issue text is generated and must not be.
.agents/tasks/_task-issue-*.md

# --- Python / build artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
*.so
.Python
pip-wheel-metadata/
# setuptools-scm / hatch-vcs generated version file
src/tether/_version.py
# uv's local lockfile (Tether's dependency source of truth is conda-lock, not uv)
uv.lock

# --- Virtual environments ---
.venv/
venv/
env/
.conda/
.mamba/

# --- Test / coverage / type / lint caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Project store working files & experiment markers (PRD §5.1, §5.4) ---
# local working project stores (fixtures are committed explicitly)
*.tether
# single-writer experiment lock markers (PRD §5.4); also catches local uv.lock
*.lock
# but DO track the committed dependency locks
!conda-lock.yml
!sidecar/conda-lock.yml

# --- Local-only cached Zarr movie pyramid scratch (never synced; PRD §4.1/§5.1) ---
*.zarr/
.zarr_scratch/

# --- M9 packaging (constructor) build artifacts (ADR-0049) ---
# construct.yaml consumes these, but they are generated at build time by
# .github/workflows/packaging.yml (rendered per-platform explicit locks; the
# staged wheels + license). packaging/dist/ is already covered by dist/ above.
packaging/locks/
packaging/staging/

# --- Docs / tooling generated artifacts ---
# mkdocs build output
site/
# graphify knowledge-graph artifact
graphify-out/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
