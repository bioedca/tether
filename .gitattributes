# Line-ending normalization for the 3-OS CI matrix on Windows-primary development
# (PRD §12.1). Text files are normalized to LF in the repo; checkout is native.
* text=auto

# Shell scripts materialize with LF on every platform: packaging/scripts/install_smoke.sh
# is executed by git-bash on the Windows packaging/release runners, whose images set
# core.autocrlf=true — a native (CRLF) checkout there makes bash reject the script
# ($'\r': command not found) before the first probe runs (issue #217).
*.sh text eol=lf

# Self-drift golden files (#702): the same bytes on every OS, so `update_golden.py` on a
# Windows checkout leaves an unchanged file unchanged and the suite reads what it wrote.
tests/golden/*.json text eol=lf

# --- Binary file types: never line-ending-normalized (avoids corrupting data) ---
*.tif   binary
*.tiff  binary
*.hdf5  binary
*.h5    binary
*.tether binary
*.mat   binary
*.tdat  binary
*.tmap  binary
*.smd   binary
*.npy   binary
*.npz   binary
*.png   binary
*.pdf   binary
*.gz    binary
*.zip   binary
# Brand kit (#671): icon containers and the bundled font files.
*.ico   binary
*.icns  binary
*.ttf   binary

# Third-party reference files in plain git keep their exact bytes on every OS, so the SHA-256 in
# tests/reference_data/manifest.toml also holds on a Windows (core.autocrlf) checkout (#696).
tests/fixtures/kinsoft_trace_sample.txt -text
tests/fixtures/pysmacks_tutorial_reference.json -text
tests/fixtures/kinsoft_simulator/*.cfg -text
# Frozen MATLAB reference outputs (#700, ADR-0074): their SHA-256 is recorded, so the
# checkout must keep their bytes on every platform (no CRLF on Windows).
tests/fixtures/reference/** -text
# smfret-analysis2 test data (#709): verbatim upstream bytes, SHA-256 in the manifest.
tests/fixtures/smfret_analysis2/** -text
# The unchanged CC BY-NC-ND copies of the paper's Source Data (#755, ADR-0083): the licence permits
# no changed copy, and their SHA-256 is recorded, so no checkout may convert a line ending.
tests/fixtures/campos_chavez_2024/** -text
# Ha-laboratory SAM/SAH files (#796, ADR-0086): verbatim Zenodo bytes (CRLF text and binary
# .traces), SHA-256 in the manifest.
tests/fixtures/ha_sam_sah/** -text

# --- Git-LFS: the LARGE-fixture / benchmark tier only (PRD §8 NFR-FIXTURES) ---
# The ≈0.9 GB UCKOPSB movie, kinSoftChallenge assets, and large *.hdf5 benchmarks
# live under these gated paths and are tracked by LFS; the SMALL committed fixtures
# under tests/fixtures/ (NOT .../large/) stay in plain git (PRD §8 NFR-FIXTURES).
tests/fixtures/large/**  filter=lfs diff=lfs merge=lfs -text
benchmarks/large/**      filter=lfs diff=lfs merge=lfs -text

# Keep the committed dependency locks diffable as text
conda-lock.yml          text
sidecar/conda-lock.yml  text
deep/conda-lock.yml     text
